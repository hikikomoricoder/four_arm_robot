<launch>
    <!-- Standalone RViz pose debugging (no Gazebo).
         Loads a saved joint-state pose and renders the robot in RViz. Run it
         ALONE: launching it next to my_robot_gazebo.launch.xml would start a
         second robot_state_publisher / odometry TF source and corrupt the TF
         tree (that conflict is what produced the "TF contains a cycle" error). -->

    <!-- Pose preset to load (my_robot_description/config/poses/*.yaml) -->
    <arg name="pose_file" default="$(find-pkg-share my_robot_description)/config/poses/default.yaml" />
    <!-- Chain the slider GUI after the preset for interactive fine tuning -->
    <arg name="use_gui" default="true" />
    <!-- In GUI mode the preset publishes this many messages to seed the GUI and
         then yields, so the sliders are not continuously overwritten. -->
    <arg name="preset_publish_count" default="50" />

    <let name="urdf_path" value="$(find-pkg-share my_robot_description)/urdf/four_arm_robot.xml.xacro" />
    <let name="rviz_config_path" value="$(find-pkg-share my_robot_description)/rviz/urdf_config.rviz" />
    <let name="robot_description" value="$(command 'xacro $(var urdf_path)')" />

    <!-- Single TF source for this debugging session -->
    <node pkg="robot_state_publisher" exec="robot_state_publisher">
        <param name="robot_description" value="$(var robot_description)" />
    </node>

    <!-- There is no Gazebo odometry here: publish a static odom->base_footprint
         so the shared RViz config (Fixed Frame: odom) works and the TF tree has
         the same shape as the one published by my_robot_gazebo.launch.xml. -->
    <node pkg="tf2_ros" exec="static_transform_publisher" args="0 0 0 0 0 0 odom base_footprint" />

    <!-- GUI mode: preset seeds the GUI with the saved pose on an intermediate
         topic, then the GUI owns /joint_states for interactive fine tuning. -->
    <node pkg="my_robot_description" exec="joint_states_preset" name="joint_states_preset_seed" if="$(var use_gui)">
        <param name="config_file" value="$(var pose_file)" />
        <param name="joint_states_topic" value="/joint_states_preset" />
        <param name="publish_count" value="$(var preset_publish_count)" />
    </node>
    <node pkg="joint_state_publisher_gui" exec="joint_state_publisher_gui" if="$(var use_gui)">
        <param name="source_list" value="['/joint_states_preset']" />
    </node>

    <!-- Headless mode: preset drives /joint_states directly and continuously. -->
    <node pkg="my_robot_description" exec="joint_states_preset" name="joint_states_preset" unless="$(var use_gui)">
        <param name="config_file" value="$(var pose_file)" />
        <param name="joint_states_topic" value="/joint_states" />
    </node>

    <node pkg="rviz2" exec="rviz2" output="screen" args="-d $(var rviz_config_path)" />
</launch>
